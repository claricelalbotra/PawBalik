# PawBalik settings. Copy this file to .env and fill in real values.
# NEVER commit .env. Only placeholders belong in this file.
# `KEY = value` and `KEY=value` both work. Empty values mean "not set".

# --- Core ---------------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5000
APP_TIMEZONE=Asia/Manila
# PAWBALIK_CONFIG=development        # development | production (testing is for pytest)
HOST=127.0.0.1
PORT=5000

# --- Database (XAMPP MySQL/MariaDB: user root, empty password) -------------------------
DATABASE_URL=mysql+pymysql://root:@localhost/pawbalik?charset=utf8mb4

# --- Admin account created by `python run.py seed` ----------------------------------
ADMIN_EMAIL=admin@pawbalik.local
ADMIN_PASSWORD=change-me-Admin123

# --- Google Gemini (photo analysis) -------------------------------------------------------
# Get a key at https://aistudio.google.com/ (empty = scans use coarse ranking only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=3
GEMINI_MAX_WORKERS=4

# --- Photo storage ------------------------------------------------------------------------
# auto = Cloudinary when CLOUDINARY_URL is set, otherwise local files in UPLOAD_FOLDER
STORAGE_BACKEND=auto
# e.g. cloudinary://API_KEY:API_SECRET@CLOUD_NAME (empty = local storage)
CLOUDINARY_URL=
CLOUDINARY_FOLDER_ROOT=pawbalik
# Default: <project folder>/uploads/pets
UPLOAD_FOLDER=
MAX_UPLOAD_BYTES=8388608
MAX_CONTENT_LENGTH=50331648
SCAN_PHOTO_RETENTION_DAYS=30

# --- Map picker & service area (Tacloban City bounding box) -------------------------------
MAP_PICKER=leaflet
OUT_OF_AREA_POLICY=reject
SERVICE_AREA_SOUTH=11.15
SERVICE_AREA_NORTH=11.40
SERVICE_AREA_WEST=124.88
SERVICE_AREA_EAST=125.08

# --- Matching (SPEC 6) -----------------------------------------------------------------------
MATCH_WEIGHT_VISUAL=0.70
MATCH_WEIGHT_ATTRIBUTE=0.15
MATCH_WEIGHT_DISTANCE=0.10
MATCH_WEIGHT_RECENCY=0.05
MATCH_RADIUS_KM=15
MATCH_DATE_WINDOW_DAYS=60
MATCH_TOP_N=15
MATCH_RELEVANCE_THRESHOLD=40
MATCH_NOTIFY_THRESHOLD=75
SIGHTING_EXPIRY_DAYS=30

# --- Background jobs -------------------------------------------------------------------------
# true = run jobs inline (no `python run.py worker` needed; slower requests)
JOBS_EAGER=false
JOBS_EAGER_RAISE=false
JOBS_MAX_ATTEMPTS=3
JOBS_BACKOFF_SECONDS=30
JOBS_LOCK_TIMEOUT_SECONDS=600
WORKER_POLL_SECONDS=3

# --- SMS (bulksms.com.ph) ----------------------------------------------------------------------
# console = print SMS to the terminal (development)
SMS_PROVIDER=console
SMS_DAILY_MATCH_LIMIT=5
# TODO(verify) with the bulksms.com.ph API documentation
BULKSMS_API_URL=
BULKSMS_API_KEY=
BULKSMS_SENDER_NAME=PawBalik
BULKSMS_TIMEOUT_SECONDS=15
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Push notifications (Firebase Cloud Messaging) --------------------------------------------
PUSH_PROVIDER=fcm
# Service-account JSON downloaded from Firebase (keep it OUT of git)
# e.g. C:/keys/firebase-service-account.json (empty = push disabled)
FIREBASE_CREDENTIALS_PATH=
# Firebase web-app config (Project settings > General > Your apps) - public values
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Cloud Messaging > Web Push certificates > Key pair
FIREBASE_VAPID_KEY=
FIREBASE_JS_VERSION=10.14.1

# --- Rate limits (Flask-Limiter syntax) -----------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=10 per minute;50 per hour
RATE_LIMIT_REGISTER=10 per hour
RATE_LIMIT_SCANS=20 per hour
RATE_LIMIT_REPORTS=10 per hour
RATE_LIMIT_AVATAR=20 per hour
RATE_LIMIT_SIGHTINGS=20 per hour
RATE_LIMIT_MESSAGES=30 per minute;300 per hour
RATE_LIMIT_OTP=5 per hour
RATE_LIMIT_RESCUE_REQUESTS=20 per hour
RATE_LIMIT_ABUSE_REPORTS=10 per hour

# --- Messaging -------------------------------------------------------------------------------
MESSAGE_POLL_SECONDS=4
